{
  "name": "dsh-token-usage",
  "version": "0.3.0",
  "private": true,
  "description": "Token usage dashboard for the DeepSeek Harness Web GUI: a Conversation view tab with one line chart for input, output and cache tokens, split by time range and API.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "dashboard",
    "chart"
  ],
  "author": "lihaifeng",
  "homepage": "https://github.com/lhf6623/dsh-token-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhf6623/dsh-token-usage.git"
  },
  "bugs": {
    "url": "https://github.com/lhf6623/dsh-token-usage/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/",
    "screenshot": "node docs/make-screenshot.cjs",
    "verify:screenshot": "node docs/check-screenshot.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
